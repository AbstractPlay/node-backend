{
  "name": "abstractplay-backend",
  "version": "1.0.0-beta",
  "description": "node.js lambda with DynamoDB",
  "type": "module",
  "scripts": {
    "build:lambda-bundles": "node scripts/build-lambda-test-bundles.mjs",
    "pretest": "npm run build:lambda-bundles",
    "test": "npm run typecheck && vitest run && node --test test/lambdaInit.test.mjs test/scripts/crons-ap-pins.test.mjs test/scripts/locale-prune.test.mjs test/scripts/translate-merge.test.mjs test/scripts/check-weblate-branch.test.mjs",
    "test:watch": "vitest",
    "test:scripts": "node --test test/scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:layers": "node scripts/build-layers.mjs",
    "test:layers": "npm run build:layers && node scripts/smoke-layer-modules.mjs",
    "lint": "node scripts/check-locale-json-format.mjs && eslint && npm run check-crons-ap-pins && npm run typecheck && npm run lint:crons",
    "check-locale-json-format": "node scripts/check-locale-json-format.mjs",
    "build": "npm run lint",
    "deploy-dev": "serverless deploy",
    "deploy-prod": "serverless --stage prod deploy",
    "full-dev": "npm run build && serverless deploy",
    "full-prod": "npm run build && serverless --stage prod deploy",
    "translate": "node scripts/translate.mjs locales/en/apback.json",
    "prune-locales": "node scripts/locale-prune.mjs locales/en/apback.json",
    "check-weblate-branch": "node scripts/check-weblate-branch.mjs",
    "check:clock-derivation": "node scripts/check-clock-derivation.mjs",
    "merge-weblate-branch": "node scripts/merge-weblate-branch.mjs",
    "dump-dashboard": "tsx scripts/dump-dashboard.mjs",
    "import-bgg-wishlist": "tsx scripts/import-bgg-wishlist.mjs",
    "import-discord-feedback": "tsx scripts/import-discord-feedback.mjs",
    "import-discord-announcements": "tsx scripts/import-discord-announcements.mjs",
    "generate-announcements-rss": "tsx scripts/generate-announcements-rss.mjs",
    "verify-division-standings": "tsx scripts/verify-division-standings.mjs",
    "analyze-ladder-calibration": "tsx scripts/analyze-ladder-calibration.mjs",
    "analyze-ladder-delta-monte-carlo": "tsx scripts/analyze-ladder-delta-monte-carlo.mjs",
    "report-bgg-wishlist-users": "tsx scripts/report-bgg-wishlist-users.mjs",
    "report-discord-feedback-users": "tsx scripts/report-discord-feedback-users.mjs",
    "feedback-archive": "tsx scripts/feedback-archive.mjs",
    "feedback-attachment-cleanup": "tsx scripts/feedback-attachment-cleanup.mjs",
    "backfill-feedback-user-engagement": "tsx scripts/backfill-feedback-user-engagement-indexes.mjs",
    "backfill-feedback-discord-user-index": "tsx scripts/backfill-feedback-discord-user-index.mjs",
    "backfill-wishlist-bgg-images": "tsx scripts/backfill-wishlist-bgg-images.mjs",
    "backfill-blank-user-names": "tsx scripts/backfill-blank-user-names.mjs",
    "backfill-orb-game-variants": "tsx scripts/backfill-orb-game-variants.mjs",
    "backfill-guerrilla-match-stack": "tsx scripts/backfill-guerrilla-match-stack.mjs",
    "dedupe-completed-game-indexes": "tsx scripts/dedupe-completed-game-indexes.mjs",
    "backfill-tournament-by-user": "tsx scripts/backfill-tournament-by-user.mjs",
    "backfill-ladder-by-user": "tsx scripts/backfill-ladder-by-user.mjs",
    "backfill-ladder-join-seeds": "tsx scripts/backfill-ladder-join-seeds.ts",
    "replay-ladder-member": "tsx scripts/replay-ladder-member.mjs",
    "reconcile-ladder-active-counts": "tsx scripts/reconcile-ladder-active-counts.ts",
    "reconcile-tournament-by-user": "tsx scripts/reconcile-tournament-by-user.mjs",
    "unblock-stuck-tournaments": "tsx scripts/unblock-stuck-tournaments.mjs",
    "repair-tournament-duplicate-pairing": "tsx scripts/repair-tournament-duplicate-pairing.mjs",
    "arena-spike-scheduler": "tsx scripts/arena-spike-scheduler.mjs",
    "arena-dev-create-game": "tsx scripts/arena-dev-create-game.mjs",
    "arena-dev-smoke": "tsx scripts/arena-dev-smoke.ts",
    "arena-dev-table-smoke": "tsx scripts/arena-dev-table-smoke.ts",
    "arena-dev-table-gates": "tsx scripts/arena-dev-table-gates.ts",
    "arena-dev-flag-timeloss": "tsx scripts/arena-dev-flag-timeloss.ts",
    "sync-deps": "ap-install-deps --stage dev && node scripts/sync-crons-ap-deps.mjs --stage dev && node scripts/prune-crons-nested-ap-deps.mjs",
    "sync-deps:prod": "ap-install-deps --stage prod && node scripts/sync-crons-ap-deps.mjs --stage prod && node scripts/prune-crons-nested-ap-deps.mjs",
    "postinstall": "node scripts/sync-crons-ap-deps.mjs --stage dev",
    "check-crons-ap-pins": "node scripts/check-crons-ap-pins.mjs",
    "ci:install": "node scripts/sync-crons-ap-deps.mjs --stage dev && npm ci",
    "ci:install:prod": "node scripts/sync-crons-ap-deps.mjs --stage prod && npm ci",
    "setup-git": "node scripts/setup-git-merge-ours.mjs",
    "lint:crons": "npm run lint -w abstractplay-backend-crons",
    "test:crons": "npm run test -w abstractplay-backend-crons",
    "test:crons:layers": "npm run test:layers -w abstractplay-backend-crons"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbstractPlay/node-backend.git"
  },
  "author": "Paul van Wamelen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AbstractPlay/node-backend/issues"
  },
  "homepage": "https://github.com/AbstractPlay/node-backend#readme",
  "engines": {
    "node": ">=24",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "crons"
  ],
  "dependencies": {
    "@abstractplay/gameslib": "1.0.0-ci-40745205810.0",
    "@abstractplay/recranks": "1.0.0-ci-40745051123.0",
    "@abstractplay/renderer": "1.0.0-ci-40109814064.0",
    "@aws-sdk/client-apigatewaymanagementapi": "3.1090.0",
    "@aws-sdk/client-cloudformation": "3.1090.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1090.0",
    "@aws-sdk/client-dynamodb": "3.1090.0",
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/client-scheduler": "3.1090.0",
    "@aws-sdk/client-ses": "3.1090.0",
    "@aws-sdk/client-sqs": "3.1090.0",
    "@aws-sdk/lib-dynamodb": "3.1090.0",
    "@aws-sdk/s3-request-presigner": "3.1090.0",
    "@sunknudsen/totp": "^1.1.0",
    "aws-jwt-verify": "^5.1.1",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.1",
    "i18next": "^22.4.15",
    "ion-js": "^5.2.0",
    "lodash": "^4.17.21",
    "uuid": "^11.1.1",
    "web-push": "^3.6.3"
  },
  "devDependencies": {
    "@abstractplay/ap-deps-tools": "^1.1.2",
    "@aws-sdk/types": "^3.310.0",
    "@google/genai": "^2.13.0",
    "@types/aws-lambda": "^8.10.115",
    "@types/node": "^24",
    "@types/uuid": "^9.0.1",
    "@types/web-push": "^3.3.2",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "aws-amplify": "6.20.0",
    "eslint": "^8.39.0",
    "fs-extra": "^11.3.4",
    "i": "^0.3.7",
    "serverless": "4.42.0",
    "serverless-esbuild": "^1.57.0",
    "serverless-plugin-common-excludes": "^4.0.0",
    "serverless-scriptable-plugin": "^1.3.1",
    "tsx": "^4.8.1",
    "typescript": "^5.0.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "splaytree": "3.1.2",
    "fast-xml-parser": "^5.11.1",
    "@aws-sdk/lib-dynamodb": {
      "@aws-sdk/client-dynamodb": "$@aws-sdk/client-dynamodb"
    }
  }
}
