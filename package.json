{
  "name": "abstractplay-backend",
  "version": "1.0.0-beta",
  "description": "node.js lambda with DynamoDB",
  "main": "??",
  "scripts": {
    "test": "npm run typecheck && node --test test/gameState.test.js test/gameProjector.test.js test/dashboardGames.test.js test/push.test.js test/i18n.test.js test/commentAuth.test.js test/playerGameMarks.test.js test/wsAuth.test.js test/playgroundSaves.test.js test/recommendationEvents.test.js test/layoutFeedbackEvents.test.js test/batchRatings.test.js test/summaryRatings.test.js test/adminDeleteGame.test.js test/gameTimeout.test.js test/dashboardMaintenance.test.js test/meProfile.test.js test/touchUserLastSeen.test.js test/notifications.test.js test/aboutText.test.js test/aboutSaves.test.js test/soloGame.test.js test/tournamentGame.test.js test/lambdaInit.test.js",
    "typecheck": "tsc --noEmit",
    "build-ts": "tsc",
    "lint": "node bin/check-ci-deps.mjs && node bin/check-cjs-runtime-deps.mjs && eslint && npm run typecheck",
    "build": "npm run lint && npm run build-ts",
    "deploy-dev": "serverless deploy",
    "deploy-prod": "serverless --stage prod deploy",
    "full-dev": "npm run build && serverless deploy",
    "full-prod": "npm run build && serverless --stage prod deploy",
    "extract": "i18next 'api/**/*.ts' 'utils/**/*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbstractPlay/node-backend.git"
  },
