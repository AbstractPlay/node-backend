{
  "name": "abstractplay-backend",
  "version": "1.0.0-beta",
  "description": "node.js lambda with DynamoDB",
  "main": "??",
  "scripts": {
    "test": "npm run typecheck && npm run build-ts && node --test test/gameState.test.js test/gameProjector.test.js test/dashboardGames.test.js test/push.test.js test/i18n.test.js test/commentAuth.test.js test/playerGameMarks.test.js test/wsAuth.test.js test/playgroundSaves.test.js test/recommendationEvents.test.js test/layoutFeedbackEvents.test.js test/batchRatings.test.js test/summaryRatings.test.js test/adminDeleteGame.test.js test/gameTimeout.test.js test/dashboardMaintenance.test.js test/meProfile.test.js test/touchUserLastSeen.test.js test/notifications.test.js test/aboutText.test.js test/aboutSaves.test.js test/soloGame.test.js test/tournamentGame.test.js test/lambdaInit.test.js test/effectiveGameFlags.test.js test/challengeVariants.test.js test/scripts/locale-prune.test.mjs",
    "test:scripts": "node --test test/scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build-ts": "tsc",
    "build:layers": "node scripts/build-layers.mjs",
    "test:layers": "npm run build:layers && node scripts/smoke-layer-modules.mjs",
    "lint": "eslint && npm run typecheck",
    "build": "npm run lint && npm run build-ts",
    "deploy-dev": "serverless deploy",
    "deploy-prod": "serverless --stage prod deploy",
    "full-dev": "npm run build && serverless deploy",
    "full-prod": "npm run build && serverless --stage prod deploy",
    "extract": "i18next 'api/**/*.ts' 'utils/**/*.ts'",
    "translate": "node bin/translate.mjs locales/en/apback.json",
    "prune-locales": "node bin/locale-prune.mjs locales/en/apback.json",
    "check-weblate-branch": "node bin/check-weblate-branch.mjs",
    "merge-weblate-branch": "node bin/merge-weblate-branch.mjs",
    "sync-deps": "node bin/install-ap-deps.mjs --stage dev",
    "sync-deps:prod": "node bin/install-ap-deps.mjs --stage prod"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbstractPlay/node-backend.git"
  },
  "author": "Paul van Wamelen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AbstractPlay/node-backend/issues"
  },
  "homepage": "https://github.com/AbstractPlay/node-backend#readme",
  "engines": {
    "node": ">=24",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@abstractplay/gameslib": "1.0.0-ci-33452193426.0",
    "@abstractplay/recranks": "latest",
    "@abstractplay/renderer": "1.0.0-ci-33416463329.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.957.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1065.0",
    "@aws-sdk/client-dynamodb": "3.1090.0",
    "@aws-sdk/client-s3": "^3.374.0",
    "@aws-sdk/client-ses": "^3.321.1",
    "@aws-sdk/client-sqs": "^3.490.0",
    "@aws-sdk/lib-dynamodb": "3.1090.0",
    "@sunknudsen/totp": "^1.1.0",
    "abstractplay-backend": "file:",
    "aws-jwt-verify": "^5.1.1",
    "fflate": "^0.8.1",
    "i18next": "^22.4.15",
    "ion-js": "^5.2.0",
    "lodash": "^4.17.21",
    "web-push": "^3.6.3"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.310.0",
    "@google/genai": "^2.13.0",
    "@types/aws-lambda": "^8.10.115",
    "@types/node": "^24",
    "@types/uuid": "^9.0.1",
    "@types/web-push": "^3.3.2",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "aws-amplify": "6.20.0",
    "eslint": "^8.39.0",
    "fs-extra": "^11.3.4",
    "i": "^0.3.7",
    "i18next-parser": "^7.7.0",
    "serverless-esbuild": "^1.57.0",
    "serverless-plugin-common-excludes": "^4.0.0",
    "serverless-scriptable-plugin": "^1.3.1",
    "typescript": "^5.0.4"
  },
  "overrides": {
    "splaytree": "3.1.2",
    "@aws-sdk/lib-dynamodb": {
      "@aws-sdk/client-dynamodb": "$@aws-sdk/client-dynamodb"
    },
    "@abstractplay/renderer": "1.0.0-ci-33416463329.0"
  }
}
