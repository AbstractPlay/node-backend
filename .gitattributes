# Requires `npm run setup-git` once per clone (registers merge.ours driver). Without it, Git
# ignores merge=ours and you get conflicts on every develop↔main merge.
#
# "Ours" = the branch you merge *into* (main keeps prod pins; develop keeps dev pins).
# package.json is merged normally so npm "scripts" paths stay in sync across branches;
# after develop→main, run `npm run sync-deps:prod` on main if @abstractplay pins drifted.
# After merging, run sync-deps / sync-deps:prod on that branch if you intend to bump pins.
# GitHub PR merges do not run merge drivers — merge locally or keep the PR base branch copies.

ci-deps.prod.json merge=ours
ci-deps.dev.json merge=ours
package-lock.json merge=ours
crons/package.json merge=ours
